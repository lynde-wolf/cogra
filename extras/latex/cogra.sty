%% cogra.sty
%% A LaTeX style approximating the look of a 1950s-1960s American
%% experimental psychology journal page (letterpress era).
%% This is an aesthetic approximation, not a reconstruction of any
%% specific journal's house specification.
%%
%% Options:
%%   journal   (default) 7in x 10in trim, single column, 10pt body
%%   twocol    letter paper, two narrow columns (closer to Science)
%%   thesis    letter paper, 1in margins, 12pt-ish leading, for
%%             committee/graduate-school copies
%%   aged      tint the page a faded newsprint color (screen only;
%%             turn off for printing)
%%
%% Engines: LuaLaTeX or XeLaTeX use TeX Gyre Schola (a free
%% Century Schoolbook clone). pdfLaTeX falls back to newcent.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cogra}[2026/10/29 v0.1 Cognitive Revolution Aesthetic journal look]

\RequirePackage{etoolbox}
\newif\if@cogra@twocol \@cogra@twocolfalse
\newif\if@cogra@thesis \@cogra@thesisfalse
\newif\if@cogra@aged   \@cogra@agedfalse
\DeclareOption{journal}{}
\DeclareOption{twocol}{\@cogra@twocoltrue}
\DeclareOption{thesis}{\@cogra@thesistrue}
\DeclareOption{aged}{\@cogra@agedtrue}
\ProcessOptions\relax

%% ---------- Page geometry ----------
\RequirePackage{geometry}
\if@cogra@thesis
  \geometry{letterpaper, margin=1in}
\else\if@cogra@twocol
  \geometry{letterpaper, top=0.9in, bottom=0.9in, left=0.85in,
            right=0.85in, columnsep=0.28in}
  \AtBeginDocument{\twocolumn}
\else
  \geometry{paperwidth=7in, paperheight=10in, top=0.85in,
            bottom=0.9in, inner=0.8in, outer=0.9in}
\fi\fi

%% ---------- Type ----------
\RequirePackage{iftex}
\ifPDFTeX
  \RequirePackage[T1]{fontenc}
  \RequirePackage{newcent}
\else
  \RequirePackage{fontspec}
  \setmainfont{texgyreschola}[Extension=.otf,
    UprightFont=*-regular, BoldFont=*-bold,
    ItalicFont=*-italic, BoldItalicFont=*-bolditalic,
    Ligatures=TeX]
\fi
\RequirePackage[protrusion=true, expansion=false]{microtype}

% Slightly tight leading, typical of hot-metal journal pages
\if@cogra@thesis
  \linespread{1.25}
\else
  \linespread{1.02}
\fi
\setlength{\parindent}{1.5em}
\setlength{\parskip}{0pt}
\frenchspacing\relax % comment out for wide sentence spacing, also period-typical

%% ---------- Color ----------
\RequirePackage{xcolor}
\definecolor{mcink}{HTML}{1C1A17}
\definecolor{mcpaper}{HTML}{EFE8D6}
\AtBeginDocument{\color{mcink}}
\if@cogra@aged \AtBeginDocument{\pagecolor{mcpaper}} \fi

%% ---------- Headings ----------
% Centered caps for major heads, centered italic for second level,
% italic run-in for third level.
\RequirePackage{textcase}
\RequirePackage{titlesec}
\titleformat{\section}[block]
  {\centering\normalsize}{}{0pt}{\MakeTextUppercase}
\titlespacing*{\section}{0pt}{1.4\baselineskip}{0.6\baselineskip}
\titleformat{\subsection}[block]
  {\centering\normalsize\itshape}{}{0pt}{}
\titlespacing*{\subsection}{0pt}{1\baselineskip}{0.4\baselineskip}
\titleformat{\subsubsection}[runin]
  {\normalsize\itshape}{}{0pt}{}[.]
\titlespacing*{\subsubsection}{\parindent}{0.5\baselineskip}{0.5em}
\setcounter{secnumdepth}{0}

%% ---------- Title block ----------
\newcommand{\cogra@title}{}\newcommand{\cogra@author}{}
\newcommand{\cogra@affil}{}\newcommand{\cogra@note}{}
\newcommand{\cogratitle}[1]{\renewcommand{\cogra@title}{#1}}
\newcommand{\cograauthor}[1]{\renewcommand{\cogra@author}{#1}}
\newcommand{\cograaffil}[1]{\renewcommand{\cogra@affil}{#1}}
\newcommand{\cogranote}[1]{\renewcommand{\cogra@note}{#1}}
\newcommand{\cogramaketitle}{%
  \begingroup
  \centering
  {\large\MakeTextUppercase{\cogra@title}%
   \ifx\cogra@note\empty\else\footnotemark\fi\par}
  \vspace{0.9\baselineskip}
  {\small\scshape \cogra@author\par}
  \vspace{0.15\baselineskip}
  {\small\itshape \cogra@affil\par}
  \vspace{1.4\baselineskip}
  \endgroup
  \ifx\cogra@note\empty\else
    \begingroup\renewcommand\thefootnote{\fnsymbol{footnote}}%
    \footnotetext{\cogra@note}\endgroup\fi
  \suppressfloats[t]% keep floats from landing above the title
}

% Short opening summary, set small and indented both sides.
\newenvironment{cograsummary}
  {\par\small\begin{list}{}{\leftmargin=2em\rightmargin=2em}\item\relax}
  {\end{list}\vspace{0.6\baselineskip}\par}

%% ---------- Footnotes: symbols, not numbers ----------
\renewcommand{\thefootnote}{\fnsymbol{footnote}}
\renewcommand{\footnoterule}{\vspace*{-3pt}\noindent\rule{4em}{0.4pt}\vspace*{2.6pt}}

%% ---------- Running heads ----------
\RequirePackage{fancyhdr}
\newcommand{\cogra@lefthead}{}\newcommand{\cogra@righthead}{}
\newcommand{\cograrunning}[2]{\renewcommand{\cogra@lefthead}{#1}%
                          \renewcommand{\cogra@righthead}{#2}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\if@twoside
  \fancyhead[LE]{\small\thepage\hfill\MakeTextUppercase{\cogra@lefthead}\hfill}
  \fancyhead[RO]{\small\hfill\MakeTextUppercase{\cogra@righthead}\hfill\thepage}
\else
  \fancyhead[C]{\small\MakeTextUppercase{\cogra@righthead}}
  \fancyhead[R]{\small\thepage}
\fi
\fancypagestyle{plain}{\fancyhf{}\fancyfoot[C]{\small\thepage}}
\AtBeginDocument{\thispagestyle{plain}}

%% ---------- Captions and tables ----------
\RequirePackage{caption}
\DeclareCaptionLabelFormat{mcfig}{\textsc{Fig.}~#2}
\DeclareCaptionLabelFormat{mctab}{\MakeTextUppercase{Table}~#2}
\captionsetup[figure]{labelformat=mcfig, labelsep=period,
  font=small, justification=justified, singlelinecheck=true}
\captionsetup[table]{labelformat=mctab, labelsep=newline,
  font={small}, textfont={sc}, justification=centering,
  position=top, skip=4pt}
\RequirePackage{booktabs}
% Thinner rules than booktabs defaults read closer to metal rule
\setlength{\heavyrulewidth}{0.6pt}
\setlength{\lightrulewidth}{0.35pt}

%% ---------- References ----------
\RequirePackage[authoryear,round]{natbib}
\setlength{\bibsep}{0pt}
\setlength{\bibhang}{1.5em}
\renewcommand{\bibfont}{\small}
\renewcommand{\bibsection}{\section{References}}

%% ---------- Figures: pgfplots "inked" style ----------
\RequirePackage{pgfplots}
\pgfplotsset{compat=1.17}
\pgfplotsset{cogra/.style={
  axis lines=left, axis line style={line width=0.6pt, -},
  tick style={line width=0.5pt}, tick align=inside,
  major tick length=3pt,
  grid=none, legend style={draw=none, font=\small, fill=none},
  every axis label/.append style={font=\small\scshape},
  tick label style={font=\small},
  every axis plot/.append style={line width=0.7pt, mark size=2pt,
                                 color=mcink},
  cycle list={
    {mark=o, solid}, {mark=*, solid},
    {mark=triangle, dashed}, {mark=triangle*, dashed},
    {mark=square, densely dotted}},
}}
\endinput
