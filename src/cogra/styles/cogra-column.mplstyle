# cogra-column: one column of the cogra.paper page (191 pt = 2.65 in), with
# type at the size it prints. Use on top of cogra:
#   plt.style.use(["cogra", "cogra-column"])
figure.figsize:     2.65, 2.0
font.size:          8
axes.labelpad:      4
lines.linewidth:    0.9
lines.markersize:   4.2
lines.markeredgewidth: 0.8
axes.linewidth:     0.7
xtick.major.size:   3
ytick.major.size:   3
xtick.major.width:  0.6
ytick.major.width:  0.6
hatch.linewidth:    0.6
errorbar.capsize:   2
legend.fontsize:    7
